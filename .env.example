# Gemini API Key (Warning: Exposing this in a client-side Vite app is fine for prototypes/hackathons, but insecure for production)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# VirusTotal API Key (Free tier: 4 lookups/min, 500/day)
VITE_VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Numverify API Key
VITE_NUMVERIFY_API_KEY=your_numverify_api_key_here